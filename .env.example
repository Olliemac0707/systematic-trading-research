# Safe, non-secret local defaults. Do not add API keys, tokens, or private keys.
TRADING_RESEARCH_ENVIRONMENT=development
TRADING_RESEARCH_LOG_LEVEL=INFO

# Market-data adapters remain replaceable. "mock" performs no network requests.
TRADING_RESEARCH_MARKET_DATA__PROVIDER=mock
TRADING_RESEARCH_MARKET_DATA__REQUEST_TIMEOUT_SECONDS=10

# Backtests and paper trading are simulations only.
TRADING_RESEARCH_BACKTEST__INITIAL_CASH=100000
TRADING_RESEARCH_BACKTEST__TRADE_QUANTITY=10
TRADING_RESEARCH_BACKTEST__COMMISSION_BPS=0
TRADING_RESEARCH_BACKTEST__SLIPPAGE_BPS=0
TRADING_RESEARCH_PAPER_TRADING__INITIAL_CASH=100000
